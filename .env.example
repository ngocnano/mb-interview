# Sao chép thành .env rồi chạy `node scripts/init-env.mjs` để điền mật khẩu ngẫu nhiên.
# KHÔNG commit .env (đã có trong .gitignore). Mọi giá trị ở đây chỉ là giả.
NODE_ENV=development

# Tài khoản quản trị Oracle (SYS) cho container
ORACLE_PASSWORD=change-me-sys

# Kết nối DB
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_OWNER_USER=INTERVIEW_OWNER
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER=INTERVIEW_APP
DB_APP_PASSWORD=change-me-app

# Backend
PORT=8080
# Khóa ký JWT: tối thiểu 32 byte, bắt buộc, không có giá trị mặc định (NFR1.2)
JWT_SECRET=change-me-change-me-change-me-change-me
# Danh sách nguồn được phép gọi API, ngăn cách bằng dấu phẩy; rỗng = từ chối nguồn khác (NFR1.13)
CORS_ORIGINS=
# Chi phí bcrypt (mặc định 10)
BCRYPT_COST=10
# Thư mục chứa bản Flutter Web đã build (tùy chọn)
WEB_DIR=
# Số lớp reverse proxy phía trước backend (0 nếu không có). Đặt 1 khi chạy sau proxy HTTPS.
TRUST_PROXY=0
